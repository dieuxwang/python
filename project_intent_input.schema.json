{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/project-intent-input.schema.json",
  "title": "Project Intent Input Model",
  "description": "Schema for the Project Intent Input Model used before WBS synthesis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_profile",
    "objectives_and_deliverables",
    "hard_constraints"
  ],
  "properties": {
    "project_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "project_type",
        "delivery_mode",
        "start_date",
        "target_end_date"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_type": {
          "type": "string",
          "enum": ["network", "cloud", "software", "data", "generic"]
        },
        "delivery_mode": {
          "type": "string",
          "enum": ["onsite", "remote", "hybrid"]
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "target_end_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "objectives_and_deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_objectives", "key_deliverables"],
      "properties": {
        "primary_objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "hard_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraints"
      ],
      "properties": {
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compliance",
            "cutover_required",
            "cutover_window_hours",
            "blackout_dates",
            "downtime_tolerance"
          ],
          "properties": {
            "compliance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "cutover_required": {
              "type": "boolean"
            },
            "cutover_window_hours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "blackout_dates": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              },
              "uniqueItems": true
            },
            "downtime_tolerance": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "cutover_required": {
                    "const": false
                  }
                },
                "required": ["cutover_required"]
              },
              "then": {
                "properties": {
                  "cutover_window_hours": {
                    "maximum": 99999
                  }
                }
              }
            }
          ]
        }
      }
    },
    "complexity_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_complexity",
        "stakeholder_complexity",
        "delivery_risk"
      ],
      "properties": {
        "technical_complexity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "stakeholder_complexity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "delivery_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "roles_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery_roles", "approval_roles"],
          "properties": {
            "delivery_roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "approval_roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "governance_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_stage_gate",
        "require_formal_signoff",
        "documentation_level"
      ],
      "properties": {
        "require_stage_gate": {
          "type": "boolean"
        },
        "require_formal_signoff": {
          "type": "boolean"
        },
        "documentation_level": {
          "type": "string",
          "enum": ["light", "standard", "heavy"]
        }
      }
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "estimation_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimation_mode",
        "working_days_per_week"
      ],
      "properties": {
        "estimation_mode": {
          "type": "string",
          "enum": ["rough", "conservative", "aggressive"]
        },
        "working_days_per_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    }
  }
}
